FROM ubuntu:22.04

# Install build tools and dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    g++ \
    make \
    curl \
    strace \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY . .

# Build the project
RUN make re

# Expose ports
EXPOSE 8081 8083

# Run the server with Docker-specific config
CMD ["./build/webserv", "simple.conf"]
