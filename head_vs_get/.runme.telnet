# Test: head_vs_get
# Description: Tests HEAD method returns same headers as GET but without body.
# Port: 8080
#
# Usage: telnet localhost 8080
# Then copy/paste each request below (including the blank line at the end)

# ========================================
# Request 1: HEAD /
# ========================================
HEAD / HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 2: GET /
# ========================================
GET / HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 3: HEAD /large.html
# ========================================
HEAD /large.html HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 4: GET /large.html
# ========================================
GET /large.html HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 5: GET Content-Length
# ========================================
GET Content-Length HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 6: GET Content-Length
# ========================================
GET Content-Length HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
# Request 7: GET Content-Type
# ========================================
GET Content-Type HTTP/1.0
Host: localhost:8080
Connection: close


# ========================================
